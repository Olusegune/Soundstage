{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundstage",
  "version": "0.2.0",
  "identifier": "app.soundstage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Soundstage",
        "width": 1366,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#090B0F",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/Soundstage/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "The whole sound side of a film, in one desktop app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/ffmpeg.exe", "resources/FFMPEG-LICENSE.txt", "resources/FFMPEG-NOTICE.txt"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
